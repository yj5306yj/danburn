{
  "name": "danburn",
  "compatibility_date": "2026-09-27",
  "workers_dev": true,
  "main": "src/index.js",
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "not_found_handling": "404-page",
    "run_worker_first": ["/media/*"]
  },
  "routes": [
    { "pattern": "danburn.kr", "custom_domain": true },
    { "pattern": "www.danburn.kr", "custom_domain": true }
  ]
}
